    {
      "parameters": {
        "jsCode": "const allLeads = $input.all();\nconst webhookData = $('Webhook (lead-lookup)').first().json;\nconst incomingPhone = webhookData.body.phone_number;\n\nconst match = allLeads.find(item => {\n  const leadPhone = (item.json.Phone || '').replace(/\\s+/g, '').replace(/[^\\d+]/g, '');\n  const incoming = (incomingPhone || '').replace(/\\s+/g, '').replace(/[^\\d+]/g, '');\n  return leadPhone === incoming;\n});\n\nif (!match) {\n  return [{ json: { lead_name: 'друже', company: '', phone: incomingPhone } }];\n}\n\nreturn [{\n  json: {\n    lead_name: match.json.Full_Name || 'друже',\n    company: match.json.Company || '',\n    phone: match.json.Phone || ''\n  }\n}];"
      },
