{
  "name": "WF1a_Call_Trigger",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json.headers;\n\n// Only process if lead is genuinely new\nif (!lead.phone || lead.phone === '') {\n  throw new Error('No phone number - skipping');\n}\n\nlet phone = lead.phone || '';\nphone = phone.replace(/\\s+/g, '').replace(/[^\\d+]/g, '');\n\nif (phone.startsWith('0')) {\n  phone = '+38' + phone;\n} else if (phone.startsWith('380')) {\n  phone = '+' + phone;\n}\n\nreturn [{\n  json: {\n    phone: phone,\n    lead_name: lead.full_name || 'Unknown',\n    company: lead.company || '',\n    lead_id: lead.id || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [208, 0],
