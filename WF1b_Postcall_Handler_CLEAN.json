    {
      "parameters": {
        "jsCode": "const allLeads = $input.all();\n\nconst targetPhone = allLeads[0].json.Phone.replace(/\\s+/g, '').replace(/[^\\d+]/g, '');\n\nconst match = allLeads.find(item => {\n  const leadPhone = (item.json.Phone || '').replace(/\\s+/g, '').replace(/[^\\d+]/g, '');\n  return leadPhone === targetPhone;\n});\n\nif (!match) {\n  throw new Error('No lead found');\n}\n\nreturn [{\n  json: {\n    lead_id: match.json.id,\n    lead_name: match.json.Full_Name,\n    phone: match.json.Phone\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, -112],
