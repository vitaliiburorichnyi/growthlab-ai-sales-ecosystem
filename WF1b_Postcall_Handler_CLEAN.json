    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body;\n\nconst summary = data.analysis?.transcript_summary || '';\nconst phone = data.conversation_initiation_client_data\n              ?.dynamic_variables?.phone_number || '';\n\nreturn [{\n  json: {\n    phone: phone,\n    summary: summary,\n    transcript: JSON.stringify(data.transcript || []),\n    conversation_id: data.conversation_id || '',\n    lead_name: 'Unknown',\n    company: 'Unknown',\n    ai_score: 0,\n    ai_context: summary\n  }\n}];"
      },
